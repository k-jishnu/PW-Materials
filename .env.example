# ==============================================================================
# PW Materials — Environment Variables Configuration Example
# Copy this file to .env (or .env.local) and insert your project keys.
# NEVER commit your real .env or secret keys to GitHub or version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL & Storage Configuration (Frontend Safe)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. AI Vision Model Configuration (Server-Side ONLY)
# Used by Vite dev server (/api/recognize), Vercel serverless, and Edge Functions.
# Kept strictly server-side; NEVER exposed to client-side bundles.
#
# Option A: Google Gemini (Recommended - Free Tier & High Precision)
# Obtain API key from: https://aistudio.google.com/app/apikey
# Recommended model: gemini-3.8-flash
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Option B: OpenAI Vision (Alternative)
# Obtain API key from: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
